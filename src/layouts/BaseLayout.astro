---
// The single page shell, in the lab's "Clinical Instrument" design system.
//
// Two jobs, kept apart deliberately:
//
// 1. SEO. Everything a crawler needs is emitted statically. The site this
//    replaced served all eight of its pages from one URL behind jQuery
//    `.load()` calls, so a crawler fetching any of them received 2.6 KB of
//    routing script and no content, under one shared title with an empty
//    description. Each page now has its own URL, title, description, canonical
//    link, hreflang pair and structured data.
//
// 2. Chrome. A sticky nav with the lab's logo lockup and a colophon footer,
//    both per the design system. No client-side JavaScript is needed to render
//    any of it; the only script on the site is the legacy-URL shim on the home
//    page, inert for anyone arriving at a current URL.
//
// CJK typography is not branched here. The `lang` attribute drives it: the
// :lang() block in styles/tokens/typography.css swaps the resolved measure,
// size, leading, alignment and kicker treatment for Chinese.
import '../styles/site.css';
import { getStrings, type Locale } from '../lib/data';
import { ROUTES, langTag, otherLocale, pathFor } from '../lib/routes';
import MobileNav from '../components/ds/MobileNav.astro';

interface Props {
  locale: Locale;
  slug: string;
  /** Overrides the i18n title for this route; used by detail pages. */
  title?: string;
  description?: string;
  /** JSON-LD nodes to add to the site-wide Organization node. */
  structuredData?: Record<string, unknown>[];
  /** Page container width. The design system's screens all run wide. */
  width?: 'default' | 'wide';
}

const {
  locale, slug, title, description, structuredData = [], width = 'wide',
} = Astro.props;

const t = getStrings(locale);
const route = ROUTES.find((entry) => entry.slug === slug);

const pageTitle = title ?? t[route?.titleKey ?? 'home_title'] ?? t.lab_name;
const pageDescription = description ?? t[route?.descriptionKey ?? 'home_description'] ?? '';

// A distinct <title> per page, with the lab name appended everywhere except the
// home page, where it would read as a duplicate.
const documentTitle = slug === ''
  ? `${pageTitle} | ${t.university}`
  : `${pageTitle} | ${t.lab_name_short} · ${t.university}`;

const site = Astro.site ?? new URL('https://www.cmdm.tw');
const canonical = new URL(pathFor(slug, locale), site).href;
const alternates: Array<{ hreflang: string; href: string }> = [
  { hreflang: langTag('zh-Hant'), href: new URL(pathFor(slug, 'zh-Hant'), site).href },
  { hreflang: langTag('en'), href: new URL(pathFor(slug, 'en'), site).href },
  // Chinese is the primary language, so it is also the fallback for locales
  // matching neither tag.
  { hreflang: 'x-default', href: new URL(pathFor(slug, 'zh-Hant'), site).href },
];

const ogImage = new URL('/img/logo_big2.png', site).href;

// Site-wide identity. `ResearchOrganization` is the specific type for a lab;
// naming the parent university and the PI's ORCID gives search engines
// something to reconcile against ORCID and Crossref records.
const organization = {
  '@type': 'ResearchOrganization',
  '@id': `${site.href}#organization`,
  name: t.lab_name,
  alternateName: ['CMDM Lab', 'Computational Molecular Design and Metabolomics Lab'],
  url: site.href,
  logo: ogImage,
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: t.university,
    url: 'https://www.ntu.edu.tw/',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: t.footer_address,
    addressCountry: 'TW',
  },
  telephone: t.footer_phone,
  founder: {
    '@type': 'Person',
    name: locale === 'en' ? 'Yufeng Jane Tseng' : '曾宇鳳',
    identifier: 'https://orcid.org/0000-0002-8461-6181',
  },
};

// One `@graph` rather than a script tag per node. The publications page emits
// 117 ScholarlyArticle nodes; repeating `@context` in each made structured data
// half the weight of the page for no semantic gain.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    ...structuredData.map(({ '@context': _context, ...node }) => node),
  ],
};

const navRoutes = ROUTES.filter((entry) => entry.inNav);
const other = otherLocale(locale);
const year = new Date().getFullYear();
---

<html lang={langTag(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{documentTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.lab_name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_TW'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="ds-skip" href="#main">{t.label_skip_to_content}</a>

    {/* Two navs, one shown at a time. The design system's SiteNav swaps itself
        for MobileNav at 768px by calling matchMedia; a static page has no
        runtime to ask, so the swap is `display:none` on either side of the same
        breakpoint. A hidden element is not in the accessibility tree, so only
        one nav is ever announced. */}
    <MobileNav locale={locale} slug={slug} />

    <nav class="ds-nav" aria-label={t.nav_label}>
      <a class="ds-nav__brand" href={pathFor('', locale)}>
        {/* The lockup is black on transparent and only ever sits on the
            near-white page -- never on the accent red. */}
        <img class="ds-nav__logo" src="/img/logo.png" alt="" width="75" height="30" />
        <span>
          <span class="ds-nav__name">{t.lab_name_short}</span>
          <span class="ds-nav__tagline">{t.tagline}</span>
        </span>
      </a>

      <div class="ds-nav__links">
        {navRoutes.map((entry) => (
          <a
            class="ds-nav__link"
            href={pathFor(entry.slug, locale)}
            aria-current={entry.slug === slug ? 'page' : undefined}
          >{t[entry.navKey]}</a>
        ))}
        {/* A real link, not a JS handler. The old site swapped languages with
            an onclick that rewrote location.href, which left every translated
            page uncrawlable. */}
        <a
          class="ds-nav__link"
          href={pathFor(slug, other)}
          hreflang={langTag(other)}
          rel="alternate"
        >{t.nav_language}</a>
      </div>
    </nav>

    <main id="main" class={width === 'wide' ? 'ds-shell ds-shell--wide' : 'ds-shell'}>
      <slot />
    </main>

    <footer class="ds-footer">
      <div class="ds-kicker ds-kicker--neutral">{t.footer_label}</div>
      <div class="ds-footer__lines">
        <div class="ds-footer__line">{t.footer_address}</div>
        <div class="ds-footer__line">{t.footer_phone} · {t.footer_office}</div>
        <div class="ds-footer__line">&copy; 2006&ndash;{year} {t.footer_copyright}</div>
      </div>
    </footer>
  </body>
</html>
