---
// Professional activities page, shared by both locales.
//
// This content existed in the old repository as contents/prof_acts_zh.html but
// no route and no navigation link ever pointed at it, so it was unreachable on
// the live site. It has a real URL now.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hairline from './ds/Hairline.astro';
import Kicker from './ds/Kicker.astro';
import { getProfessionalActivities, getStrings, type Locale } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const activities = getProfessionalActivities(locale);

const SECTION_LABELS: Record<string, string> = {
  editorial: t.section_editorial,
  program_committee: t.section_program_committee,
  advisory: t.section_advisory,
  talks: t.section_talks,
  paper_review: t.section_paper_review,
};
---

<BaseLayout locale={locale} slug="activities">
  <div class="ds-masthead">
    <Kicker size="md">{t.activities_kicker}</Kicker>
    <Hairline tone="ink" />
    <h1 class="ds-masthead__title">{t.activities_title}</h1>
    <div class="ds-masthead__subtitle">{t.activities_subtitle}</div>
    <p class="ds-masthead__lede">{t.activities_lede}</p>
  </div>

  {Object.entries(activities).map(([key, entries]) => (
    <section class="ds-section" aria-labelledby={`act-${key}`}>
      <Kicker size="md" as="h2" id={`act-${key}`}>{SECTION_LABELS[key] ?? key}</Kicker>
      <ul class="ds-list">
        {entries.map((entry) => <li>{entry}</li>)}
      </ul>
    </section>
  ))}
</BaseLayout>
