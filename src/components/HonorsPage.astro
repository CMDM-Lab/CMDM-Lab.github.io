---
// Honors page body, shared by both locales.
//
// The old honor page mixed three unrelated things: a short list of awards, and
// then full journal-paper and patent listings that duplicated the publications
// page. The awards live here; the literature lives on the publications page.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHonors, getStrings, type Locale } from '../lib/data';
import { pathFor } from '../lib/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const honors = getHonors();
---

<BaseLayout locale={locale} slug="honors">
  <h1>{t.honors_title}</h1>

  <section aria-labelledby="achievements">
    <h2 id="achievements">{t.section_achievements}</h2>
    <ul class="honor-list">
      {honors.achievements.map((achievement) => (
        <li>
          {achievement.citation}
          {achievement.links?.map((link) => (
            <>{' '}<a href={link.url}>[{link.label}]</a></>
          ))}
        </li>
      ))}
    </ul>
  </section>

  {honors.award_highlights.length > 0 && (
    <section aria-labelledby="award-highlights">
      <h2 id="award-highlights">{t.section_award_highlights}</h2>
      <ul class="honor-list">
        {honors.award_highlights.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  )}

  <p><a href={pathFor('publications', locale)}>{t.nav_publications} &rarr;</a></p>
</BaseLayout>
