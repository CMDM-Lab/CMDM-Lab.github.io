---
// Overview page, shared by both locales.
//
// Follows the design system's Overview screen: hero masthead, the research
// pillars as a Ledger, a lab-record row pairing prose with a colophon table,
// and the page's single InkPanel.
//
// The colophon numbers are counted from the real data rather than written in,
// so they cannot go stale the way the old site's did.
//
// This page also carries the legacy-URL shim. Old inbound links use
// `?content=<key>`, which no longer means anything; GitHub Pages cannot
// redirect on a query string, so a visitor arriving with one is forwarded in
// the browser. A normal visit runs no script at all.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hairline from './ds/Hairline.astro';
import InkPanel from './ds/InkPanel.astro';
import Kicker from './ds/Kicker.astro';
import Ledger from './ds/Ledger.astro';
import LedgerItem from './ds/LedgerItem.astro';
import ColophonTable from './ds/ColophonTable.astro';
import {
  allAlumni, getHomeIntro, getHomeRecord, getHonors, getNews, getPublications,
  getResearchAreas, labAffiliations, labPublicationCount, LAB_FOUNDED, romanNumeral,
  getServices, getStrings, membersByRole, type Locale,
} from '../lib/data';
import { LEGACY_CONTENT_MAP, pathFor } from '../lib/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);

const areas = getResearchAreas(locale);
const news = getNews();

/** How many news items the front page carries before deferring to /news/. */
const HOME_NEWS_ITEMS = 5;
const achievements = getHonors(locale);
const publications = getPublications();
const services = getServices();
const alumni = allAlumni();
const current = [...membersByRole().values()].flat();
const intro = getHomeIntro(locale);
const record = getHomeRecord(locale);

const facts = [
  { label: t.label_director, value: locale === 'en' ? 'Prof. Yufeng Jane Tseng' : '曾宇鳳 教授' },
  // Read from the roster, not written here: the hand-written list said
  // "基因體所", which is not the name of anything -- GSB is a degree program --
  // and it had no 網媒所 although a member is in it.
  { label: t.label_affiliation, value: labAffiliations(locale) },
  {
    label: t.label_public_tools,
    value: locale === 'en'
      ? `${services.length} services under cmdm.tw`
      : `cmdm.tw 網域下共 ${services.length} 項服務`,
  },
  // Counted from the lab's founding, not from the length of the list: its four
  // earliest entries are the PI's own postdoc work at UIC and the NCBI, from
  // 2003-2004, before the lab existed.
  {
    label: t.nav_publications,
    value: locale === 'en'
      ? `${labPublicationCount()} since ${LAB_FOUNDED}`
      : `${LAB_FOUNDED} 年起共 ${labPublicationCount()} 篇`,
  },
  {
    label: t.label_alumni_count,
    value: locale === 'en' ? `${alumni.length} since 2008` : `2008 年起共 ${alumni.length} 人`,
  },
  {
    label: t.nav_members,
    value: locale === 'en' ? `${current.length} current members` : `現役成員 ${current.length} 人`,
  },
];


const latestAward = achievements[0];

const legacyMap = Object.fromEntries(
  Object.entries(LEGACY_CONTENT_MAP).map(([key, slug]) => [key, pathFor(slug, locale)]),
);
---

<BaseLayout locale={locale} slug="">
  <script is:inline set:html={`
    (function () {
      var map = ${JSON.stringify(legacyMap)};
      var match = /[?&]content=([a-z_]+)/.exec(window.location.search);
      if (match && map[match[1]] && map[match[1]] !== window.location.pathname) {
        window.location.replace(map[match[1]]);
      }
    })();
  `} />

  <div class="ds-masthead">
    <Kicker size="md">{t.home_kicker}</Kicker>
    <Hairline tone="ink" />
    <h1 class="ds-masthead__title ds-masthead__title--hero">{t.lab_name}</h1>
    <div class="ds-masthead__subtitle">{t.home_subtitle}</div>
    <p class="ds-masthead__lede">{t.home_lede}</p>
  </div>

  <section class="ds-section" aria-labelledby="pillars">
    <Kicker size="md" as="h2" id="pillars">{t.section_research_areas}</Kicker>
    <Ledger width="wide">
      {areas.map((area, i) => (
        <LedgerItem
          index={romanNumeral(i)}
          title={area.group}
          href={pathFor('research', locale)}
          linkLabel={t.nav_research}
          as="h3"
        >
          <ul class="ds-list ds-list--bullet">
            {area.items.map((item) => <li>{item}</li>)}
          </ul>
        </LedgerItem>
      ))}
    </Ledger>
  </section>

  <section class="ds-section" aria-labelledby="record">
    <Kicker size="md" as="h2" id="record">{t.section_lab_record}</Kicker>
    <div class="ds-row">
      <div class="ds-col">
        <div class="ds-prose ds-prose--lede">
          <p>{intro}</p>
          {record.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="ds-col--narrow">
        <ColophonTable entries={facts} />
      </div>
    </div>
  </section>

  {/* The newest few only. This list ran to ten items, all of them from 2016-2018,
      so the front page's "latest news" was seven years old and the rest of the
      page was buried under it. The full record has its own page rather than
      being trimmed away. */}
  {news.length > 0 && (
    <section class="ds-section" aria-labelledby="news">
      <Kicker size="md" as="h2" id="news">{t.section_news}</Kicker>
      <ul class="ds-list">
        {news.slice(0, HOME_NEWS_ITEMS).map((item) => (
          <li>
            {item.text}
            {item.links?.map((link) => (
              <>{' '}<a class="ds-link" href={link.url}>[{link.label}]</a></>
            ))}
          </li>
        ))}
      </ul>
      {news.length > HOME_NEWS_ITEMS && (
        <p style="margin-top:var(--space-3)">
          <a class="ds-link" href={pathFor('news', locale)}>{t.label_all_news} &rarr;</a>
        </p>
      )}
    </section>
  )}

  {publications.length > 0 && (
    <section class="ds-section" aria-labelledby="recent">
      <Kicker size="md" as="h2" id="recent">{t.section_latest_publications}</Kicker>
      <Ledger width="wide">
        {publications.slice(0, 4).map((publication) => (
          <LedgerItem
            title={publication.title}
            meta={[publication.journal, publication.year].filter(Boolean).join(' · ')}
            href={publication.doi ? `https://doi.org/${publication.doi}` : undefined}
            linkLabel={t.label_publisher}
            as="h3"
          />
        ))}
      </Ledger>
      <p style="margin-top:var(--space-3)">
        <a class="ds-link" href={pathFor('publications', locale)}>{t.nav_publications} &rarr;</a>
      </p>
    </section>
  )}

  {/* The page's single InkPanel. Two on one page would mean neither reads as
      emphasis, so this is the only one. */}
  {latestAward && (
    <div class="ds-section">
      <InkPanel kicker={t.section_award_highlights}>
        <p class="ds-prose ds-prose--lede">{latestAward.citation}</p>
        {latestAward.links && (
          <p style="margin-top:var(--space-3)">
            {latestAward.links.map((link) => (
              <>
                <a class="ds-link" href={link.url}>[{link.label}]</a>{' '}
              </>
            ))}
            <a class="ds-link" href={pathFor('honors', locale)}>{t.nav_honors} &rarr;</a>
          </p>
        )}
      </InkPanel>
    </div>
  )}
</BaseLayout>
