---
// Software and web services page body, shared by both locales.
//
// These tools -- 3Omics, LipidPedia, CypRules, GC2MS, Chromaligner and the rest
// -- are the lab's most cited public output and the things most likely to be
// searched for by name. Each gets its own heading, its own anchor and a
// SoftwareApplication node so a search for the tool name can reach this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServices, getStrings, type Locale } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const services = getServices();

/** Slug a service name into a stable in-page anchor. */
const anchor = (name: string) => name
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');

const structuredData = services.map((service) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: service.name,
  applicationCategory: 'ScientificApplication',
  ...(service.description ? { description: service.description } : {}),
  ...(service.links?.length ? { url: service.links[0].url } : {}),
  provider: {
    '@type': 'ResearchOrganization',
    '@id': `${(Astro.site ?? new URL('https://www.cmdm.tw')).href}#organization`,
  },
}));
---

<BaseLayout locale={locale} slug="services" structuredData={structuredData}>
  <h1>{t.services_title}</h1>

  {services.map((service) => (
    <section class="service" id={anchor(service.name)} aria-labelledby={`svc-${anchor(service.name)}`}>
      <h2 id={`svc-${anchor(service.name)}`}>{service.name}</h2>
      {service.image && (
        <img src={service.image} alt={service.name} loading="lazy" />
      )}
      {service.description && <p>{service.description}</p>}
      {service.links?.map((link) => (
        <p><a href={link.url}>{link.label || t.label_visit_site} &rarr;</a></p>
      ))}
    </section>
  ))}
</BaseLayout>
