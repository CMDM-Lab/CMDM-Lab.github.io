---
// Research page, shared by both locales.
//
// Two sections: the research pillars as a Ledger, then representative papers as
// a wide Ledger. Figures sit on a hairline plate, per the design system's rule
// that scientific figures never bleed and always carry a mono caption.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hairline from './ds/Hairline.astro';
import Kicker from './ds/Kicker.astro';
import Ledger from './ds/Ledger.astro';
import LedgerItem from './ds/LedgerItem.astro';
import Tag from './ds/Tag.astro';
import {
  getResearchAreas, romanNumeral, getResearchHighlights, getStrings, type Locale,
} from '../lib/data';
import { pathFor } from '../lib/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const areas = getResearchAreas(locale);
const highlights = getResearchHighlights();

---

<BaseLayout locale={locale} slug="research">
  <div class="ds-masthead">
    <Kicker size="md">{t.research_kicker}</Kicker>
    <Hairline tone="ink" />
    <h1 class="ds-masthead__title">{t.research_title}</h1>
    <div class="ds-masthead__subtitle">{t.research_subtitle}</div>
    <p class="ds-masthead__lede">{t.research_lede}</p>
  </div>

  <section class="ds-section" aria-labelledby="areas">
    <Kicker size="md" as="h2" id="areas">{t.section_research_areas}</Kicker>
    <Ledger width="wide">
      {areas.map((area, i) => (
        <LedgerItem index={romanNumeral(i)} title={area.group} as="h3">
          <ul class="ds-list ds-list--bullet">
            {area.items.map((item) => <li>{item}</li>)}
          </ul>
        </LedgerItem>
      ))}
    </Ledger>
  </section>

  <section class="ds-section" aria-labelledby="papers">
    <Kicker size="md" as="h2" id="papers">{t.section_papers}</Kicker>
    <Ledger width="wide">
      {highlights.map((highlight, i) => (
        <LedgerItem
          index={romanNumeral(i)}
          title={highlight.title}
          body={highlight.excerpt}
          imageSrc={highlight.image}
          imageAlt={highlight.title}
          imageCredit={highlight.image_credit}
          meta={highlight.meta}
          href={highlight.doi ? `https://doi.org/${highlight.doi}` : undefined}
          linkLabel={t.label_publisher}
          as="h3"
        >
          {highlight.tag && (
            <Fragment slot="tags"><Tag tone="brand">{highlight.tag}</Tag></Fragment>
          )}
        </LedgerItem>
      ))}
    </Ledger>
    <p style="margin-top:var(--space-3)">
      <a class="ds-link" href={pathFor('publications', locale)}>{t.nav_publications} &rarr;</a>
    </p>
  </section>
</BaseLayout>
