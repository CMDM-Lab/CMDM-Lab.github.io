---
// About page body, shared by both locales.
//
// The Chinese locale currently renders the English prose -- see the translation
// gap note in data/pages.yml. That is a content gap for the lab to fill, not
// something to paper over with a machine translation.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutParagraphs, getStrings, type Locale } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const paragraphs = getAboutParagraphs(locale);
---

<BaseLayout locale={locale} slug="about">
  <h1>{t.about_title}</h1>
  <div class="prose">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</BaseLayout>
