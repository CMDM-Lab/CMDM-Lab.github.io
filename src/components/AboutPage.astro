---
// About page, shared by both locales.
//
// The Chinese locale currently renders the English prose: the old site had a
// `_zh` variant whose body was English, and no Chinese version exists anywhere
// in the repository. See the translation-gap note in data/pages.yml. Machine
// translating the lab's own account of its research would put words in its
// mouth, so the gap is left visible instead.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hairline from './ds/Hairline.astro';
import Kicker from './ds/Kicker.astro';
import { getAbout, getStrings, type Locale } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const { paragraphs, translated } = getAbout(locale);
---

{/* The narrower 960px shell, not the 1180px one the data-heavy pages use.
    This page is nothing but prose: Chinese sets one 38em column by design, and
    in a 1180px shell that leaves half the page empty. At 960px the same column
    reads as a centred prose page, and the English two-column flow still fills
    the measure. */}
<BaseLayout locale={locale} slug="about" width="default">
  <div class="ds-masthead">
    <Kicker size="md">{t.about_kicker}</Kicker>
    <Hairline tone="ink" />
    <h1 class="ds-masthead__title">{t.about_title}</h1>
    <div class="ds-masthead__subtitle">{t.about_subtitle}</div>
    <p class="ds-masthead__lede">{t.about_lede}</p>
  </div>

  {/* ArticleFlow, not Prose: this is the one page that is nothing but long
      prose, and a single 64ch measure left the right half of the wide shell
      empty. Two columns with a rule between them is the design system's
      treatment for exactly this, and it folds to one column under a Chinese
      document root. */}
  <div class="ds-section">
    <div class={translated ? 'ds-article-flow' : 'ds-article-flow ds-article-flow--latin'}>
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</BaseLayout>
