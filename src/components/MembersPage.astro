---
// Members page, shared by both locales.
//
// This is the page the rebuild was aimed at: it is the URL people were sent
// (`index_zh.html?content=member`) and the one that returned no content at all
// to a crawler. Every name, role and research topic below is in the initial
// HTML response.
//
// Structure follows the design system's People screen. Roles that read as
// individuals get a Ledger; roles that read as a roster get a DataTable, because
// a table of twenty names is easier to scan than twenty ledger entries.
//
// WHAT THIS PAGE DELIBERATELY DOES NOT SHOW, at the lab's direction:
//
//   Specific research topics. They come from the vault as working shorthand,
//   not as public summaries. What shows instead is the coarse area -- one of the
//   research pillars -- which keeps each entry searchable without publishing
//   what anyone is working on this month. The raw topic stays in the data and is
//   not claimed in the Person structured data.
//
//   Year of study. The lab asked for it off; the ordering already conveys
//   seniority. It stays in the data because the sort depends on it.
//
//   Email addresses, unless that person opted in. Anyone who did not is an
//   address existing nowhere but this site, so publishing here is the entire
//   exposure. Those are stripped in scripts/sync-members.mjs, so they are absent
//   from data/members.yml rather than merely unrendered.
//
// Members with no photo get no placeholder: blanks stay blank.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hairline from './ds/Hairline.astro';
import Kicker from './ds/Kicker.astro';
import Ledger from './ds/Ledger.astro';
import LedgerItem from './ds/LedgerItem.astro';
import DataTable from './ds/DataTable.astro';
import Tag from './ds/Tag.astro';
import ColophonTable from './ds/ColophonTable.astro';
import {
  allAlumni, departmentLabel, getStrings, membersByRole,
  type Locale, type Member,
} from '../lib/data';
import { pathFor } from '../lib/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const isEnglish = locale === 'en';

const grouped = membersByRole();
const alumni = allAlumni();

const displayName = (person: { name: string; name_en?: string }) => (
  isEnglish && person.name_en ? person.name_en : person.name
);
const secondaryName = (person: { name: string; name_en?: string }) => (
  isEnglish ? (person.name_en ? person.name : '') : (person.name_en ?? '')
);
const roleTitle = (member: Member) => (
  (isEnglish ? member.title_en : member.title) || member.title || ''
);
const area = (member: Member) => (
  (isEnglish ? member.area_en : member.area) || member.area || ''
);

const faculty = grouped.get('faculty') ?? [];
// Individuals: a ledger entry each.
const LEDGER_ROLES = ['staff', 'postdoc', 'phd'];
// Rosters: a table each, since a long list of names scans better as rows.
const TABLE_ROLES = ['masters', 'undergraduate', 'current'];

const site = Astro.site ?? new URL('https://www.cmdm.tw');
const membersUrl = new URL(pathFor('members', locale), site).href;

// Only current members get a Person node. Alumni are listed for the record;
// asserting a current affiliation for them would be wrong.
const people = [...grouped.values()].flat().map((member) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: displayName(member),
  ...(secondaryName(member) ? { alternateName: secondaryName(member) } : {}),
  ...(roleTitle(member) ? { jobTitle: roleTitle(member) } : {}),
  ...(member.email ? { email: member.email } : {}),
  ...(member.orcid ? { identifier: `https://orcid.org/${member.orcid}` } : {}),
  affiliation: { '@type': 'ResearchOrganization', '@id': `${site.href}#organization` },
  url: membersUrl,
}));

---

<BaseLayout locale={locale} slug="members" structuredData={people}>
  <div class="ds-masthead">
    <Kicker size="md">{t.members_kicker}</Kicker>
    <Hairline tone="ink" />
    <h1 class="ds-masthead__title">{t.members_title}</h1>
    <div class="ds-masthead__subtitle">{t.members_subtitle}</div>
    <p class="ds-masthead__lede">{t.members_lede}</p>
  </div>

  {faculty.map((member) => (
    <section class="ds-section" aria-labelledby="role-faculty">
      <Kicker size="md" as="h2" id="role-faculty">{t.role_faculty}</Kicker>
      <div class="ds-row">
        {member.photo && (
          <figure class="ds-plate" style="flex:0 0 200px">
            <img src={member.photo} alt={displayName(member)} width="600" height="902" />
          </figure>
        )}
        <div class="ds-col">
          <h3>
            {displayName(member)}
            {secondaryName(member) && <span> ({secondaryName(member)})</span>}
          </h3>
          {roleTitle(member) && <div class="ds-masthead__subtitle">{roleTitle(member)}</div>}
          <div style="margin-top:var(--space-3)">
            <ColophonTable entries={[
              ...(member.email
                ? [{ label: t.label_email, value: member.email, href: `mailto:${member.email}` }]
                : []),
              ...(member.phone ? [{ label: t.label_phone, value: member.phone }] : []),
              ...((isEnglish ? member.office_en : member.office)
                ? [{ label: t.label_office, value: (isEnglish ? member.office_en : member.office)! }]
                : []),
              ...(member.orcid
                ? [{ label: 'ORCID', value: member.orcid, href: `https://orcid.org/${member.orcid}` }]
                : []),
            ]} />
          </div>
          <p style="margin-top:var(--space-3)">
            <a class="ds-link" href={pathFor('professor', locale)}>{t.label_read_more} &rarr;</a>
          </p>
        </div>
      </div>
    </section>
  ))}

  {LEDGER_ROLES.filter((role) => grouped.has(role)).map((role) => (
    <section class="ds-section" aria-labelledby={`role-${role}`}>
      <Kicker size="md" as="h2" id={`role-${role}`}>{t[`role_${role}`] ?? role}</Kicker>
      <Ledger>
        {grouped.get(role)!.map((member) => (
          <LedgerItem
            title={[displayName(member), secondaryName(member) && `(${secondaryName(member)})`]
              .filter(Boolean).join(' ')}
            meta={[
              roleTitle(member),
              departmentLabel(member.department, locale),
              member.email,
            ].filter(Boolean).join(' · ')}
            as="h3"
          >
            {area(member) && (
              <Fragment slot="tags">
                {area(member).split(' · ').map((one) => <Tag tone="brand">{one}</Tag>)}
              </Fragment>
            )}
            {member.projects?.length ? (
              <div class="ds-meta" slot="meta">
                {t.label_projects}:{' '}
                {member.projects.map((project, i) => (
                  <>
                    {i > 0 && ' · '}
                    {project.url
                      ? (
                        <a href={project.url}>
                          {project.short ? `${project.short} — ` : ''}
                          {(isEnglish && project.name_en) || project.name}
                        </a>
                      )
                      : `${project.short ? `${project.short} — ` : ''}${(isEnglish && project.name_en) || project.name}`}
                  </>
                ))}
              </div>
            ) : null}
          </LedgerItem>
        ))}
      </Ledger>
    </section>
  ))}

  {TABLE_ROLES.filter((role) => grouped.has(role)).map((role) => (
    <section class="ds-section" aria-labelledby={`role-${role}`}>
      <Kicker size="md" as="h2" id={`role-${role}`}>{t[`role_${role}`] ?? role}</Kicker>
      <DataTable columns={[
        { label: t.label_name, width: '26%' },
        { label: t.label_department },
        { label: t.label_area, width: '26%' },
      ]}>
        {grouped.get(role)!.map((member) => (
          <tr>
            <td>{displayName(member)}{secondaryName(member) && <span> ({secondaryName(member)})</span>}</td>
            <td>{departmentLabel(member.department, locale)}</td>
            {/* Written on one line on purpose: below 768px each cell becomes a
                labelled record and `td:empty` is what drops the label of a cell
                with no value -- and a newline inside the element is a text node,
                which stops it being empty. */}
            <td>{area(member) ? area(member).split(' · ').map((one) => <Tag tone="brand">{one}</Tag>) : ''}</td>
          </tr>
        ))}
      </DataTable>
    </section>
  ))}

  <section class="ds-section" aria-labelledby="role-alumni">
    <Hairline tone="ink" />
    <Kicker size="md" as="h2" id="role-alumni">{t.role_alumni}</Kicker>
    <DataTable columns={[
      { label: t.label_year, width: '8%' },
      { label: t.label_name, width: '20%' },
      { label: t.label_department, width: '20%' },
      { label: t.label_thesis },
    ]}>
      {alumni.map((person) => (
        <tr>
          <td class="ds-num">{person.graduated ?? ''}</td>
          <td>{displayName(person)}{secondaryName(person) && <span> ({secondaryName(person)})</span>}</td>
          {/* departmentLabel spells out the vault's codes and returns anything
              else unchanged, which is what the 2008-2022 rows carry. */}
          <td class="ds-mono-sm">{departmentLabel(person.department, locale)}</td>
          {/* Only a confirmed thesis title, never the vault's working topic. */}
          <td>{person.thesis ?? ''}</td>
        </tr>
      ))}
    </DataTable>
  </section>
</BaseLayout>
